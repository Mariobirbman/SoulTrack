## Firebase Web SDK config (Vite requires the VITE_ prefix)
# Create a Firebase project -> Project settings -> "Your apps" -> Web app config
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

## Optional (local development)
# Set to "1" to use the Firebase emulators (Auth/Firestore) on localhost.
VITE_USE_FIREBASE_EMULATORS=0

## Optional (presentation / mock data)
# Set to "1" to force demo mode (fake user + mock data, no Firebase required).
VITE_DEMO_MODE=0

## Optional (development only)
# Set to "1" to bypass auth guards while styling/testing protected routes locally.
VITE_AUTH_BYPASS=0

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Vendors are user-owned profiles (doc id == vendor's auth uid).
    match /vendors/{vendorUid} {
      allow read: if true;
      allow create, update: if isSelf(vendorUid);
      allow delete: if false;
    }

    // Public product listings, owned by a vendor user (vendorUid).
    // Vendors can create/delete their own listings and update non-status fields.
    // Only admins can change the 'status' field (approved / rejected).
    match /products/{productId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.vendorUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // Vendor update: must own the product, cannot change vendorUid or status
      allow update: if signedIn()
        && resource.data.vendorUid == request.auth.uid
        && request.resource.data.vendorUid == request.auth.uid
        && request.resource.data.status == resource.data.status;

      // Admin update: can change any field including status
      allow update: if isAdmin();

      allow delete: if signedIn() && resource.data.vendorUid == request.auth.uid;
    }

    // Demo checkout: one vendor-order per vendor at checkout time.
    match /vendorOrders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid
          || resource.data.vendorUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.vendorUid is string
        && request.resource.data.checkoutId is string
        && request.resource.data.items is list
        && request.resource.data.status == 'placed';

      // Only the vendor can advance the order status; no other fields may change.
      allow update: if signedIn()
        && resource.data.vendorUid == request.auth.uid
        && request.resource.data.buyerUid == resource.data.buyerUid
        && request.resource.data.vendorUid == resource.data.vendorUid
        && request.resource.data.checkoutId == resource.data.checkoutId
        && request.resource.data.items == resource.data.items
        && request.resource.data.subtotal == resource.data.subtotal;

      allow delete: if false;

      // Per-order chat between buyer and vendor.
      match /messages/{messageId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.buyerUid == request.auth.uid
            || get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.vendorUid == request.auth.uid);

        allow create: if signedIn()
          && (get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.buyerUid == request.auth.uid
            || get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.vendorUid == request.auth.uid)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string;

        allow update, delete: if false;
      }
    }

    // Aggregated analytics written by admin when approving products.
    match /analyticsData/{monthDoc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles + per-user sales.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid);
      allow delete: if false;

      match /sales/{saleId} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Vendors are user-owned profiles (doc id == vendor's auth uid).
    match /vendors/{vendorUid} {
      allow read: if true;
      allow create, update: if isSelf(vendorUid);
      allow delete: if false;
    }

    // Public product listings, owned by a vendor user (vendorUid).
    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.vendorUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.vendorUid == request.auth.uid
        && request.resource.data.vendorUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.vendorUid == request.auth.uid;
    }

    // Demo checkout: one vendor-order per vendor at checkout time.
    match /vendorOrders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid || resource.data.vendorUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid
        && request.resource.data.vendorUid is string
        && request.resource.data.checkoutId is string
        && request.resource.data.items is list;

      allow update, delete: if false;

      // Per-order chat between buyer and vendor.
      match /messages/{messageId} {
        allow read: if signedIn()
          && (get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.buyerUid == request.auth.uid
            || get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.vendorUid == request.auth.uid);

        allow create: if signedIn()
          && (get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.buyerUid == request.auth.uid
            || get(/databases/$(database)/documents/vendorOrders/$(orderId)).data.vendorUid == request.auth.uid)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string;

        allow update, delete: if false;
      }
    }

    // User profiles + per-user sales.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /sales/{saleId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
